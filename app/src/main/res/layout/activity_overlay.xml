<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="#000512"
    android:layout_height="match_parent"
    tools:context=".OverlayActivity">

    <com.RichGuy1.pomodoro.CustomViews.ClockViewComponent
        android:id="@+id/time_layer"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="#000512"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hours_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hours_completed"
        android:textColor="@color/white"
        android:layout_margin="14dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_layer" />

    <TextView
        android:id="@+id/hours_passed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_margin="18dp"
        android:textSize="32sp"
        android:text="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hours_title" />

    <Button
        android:id="@+id/next_phase_btn"
        android:layout_width="wrap_content"
        android:padding="18dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="@string/mark_as_complete"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hours_passed" />
</androidx.constraintlayout.widget.ConstraintLayout>